<?xml version="1.0" encoding="UTF-8"?>

<component name="SettingsScreen" extends="Group">
	<script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs"/>
    
    <interface>
        <field id="navigationRequest" type="string" value="" />
    </interface>

	<children>
		<!-- Background -->
		<Rectangle
			id="Background"
			width="1920"
			height="1080"
			color="#D0CDC4">
		</Rectangle>

        <!-- Zentrierter Login-Card-Container -->
        <Group translation="[430, 120]">
            <!-- Hintergrund-Box für das Formular -->
            <Rectangle 
                width="700" 
                height="620" 
                color="#2B2B2B" 
                opacity="0.85" />

            <!-- Titel: ANMELDEN -->
            <Label 
                text="ANMELDEN" 
                font="font:LargeBoldSystemFont" 
                color="#FFFFFF" 
                width="700" 
                horizAlign="center" 
                translation="[0, 40]" />

            <!-- Email Label -->
            <Label 
                text="Email" 
                font="font:MediumSystemFont" 
                color="#A0A5AE" 
                translation="[60, 130]" />

            <!-- Email Input Field -->
            <Group id="emailFieldGroup" translation="[60, 175]">
                <Rectangle id="emailBg" width="580" height="60" color="#1F2227" />
                <Rectangle id="emailBorder" width="580" height="60" color="#3A3F47" />
                <Rectangle width="576" height="56" color="#1F2227" translation="[2, 2]" />
                <Label id="emailText" text="email@example.com" font="font:MediumSystemFont" color="#70757E" translation="[20, 12]" />
            </Group>

            <!-- Password Label -->
            <Label 
                text="Password" 
                font="font:MediumSystemFont" 
                color="#A0A5AE" 
                translation="[60, 275]" />

            <!-- Password Input Field (Maskiert) -->
            <Group id="passwordFieldGroup" translation="[60, 320]">
                <Rectangle id="passwordBg" width="580" height="60" color="#1F2227" />
                <Rectangle id="passwordBorder" width="580" height="60" color="#3A3F47" />
                <Rectangle width="576" height="56" color="#1F2227" translation="[2, 2]" />
                <Label id="passwordText" text="••••••••" font="font:MediumSystemFont" color="#70757E" translation="[20, 12]" />
            </Group>

            <!-- Log in Button -->
            <Group id="loginButton" translation="[210, 450]">
                <Rectangle id="buttonBg" width="280" height="60" color="#FFFFFF" />
                <Label id="buttonText" text="Log in" font="font:MediumSystemFont" color="#2B2B2B" width="280" height="60" horizAlign="center" vertAlign="center" />
            </Group>

            <!-- Log Out Button -->
            <Group id="logoutButton" translation="[210, 450]" visible = "false">
                <Rectangle id="buttonBg" width="280" height="60" color="#FFFFFF" />
                <Label id="buttonText" text="Log Out" font="font:MediumSystemFont" color="#2B2B2B" width="280" height="60" horizAlign="center" vertAlign="center" />
            </Group>

            <!-- Status label (hidden by default) -->
            <Label
                id="statusLabel"
                text=""
                font="font:SmallBoldSystemFont"
                size="[500,100]"
                color="0x36322E"
                horizontalAlignment="left"
                wrap = "true"
                visible = "false"
                translation="[60,550]">
            </Label>

        </Group>

        <!-- Untere Tabs-Leiste -->
        <Group translation="[0, 960]">
            <!-- Tab-Leiste Hintergrund -->
            <Rectangle 
                width="1560" 
                height="120" 
                color="#1F2227" />

            <!-- Tab Links: Login (Aktiv) -->
            <Group translation="[0, 0]">
                <Rectangle 
                    width="780" 
                    height="120" 
                    color="#2B2B2B" 
                    opacity="0.6" />
                <!-- Aktiver Indikator (weißer Balken oben/unten) -->
                <Rectangle 
                    width="780" 
                    height="4" 
                    color="#FFFFFF" 
                    translation="[0, 116]" />
                <Button
					id="LoginTabBtn"
                    text="Login" 
                    font="font:MediumSystemFont" 
                    color="#FFFFFF" 
                    width="780" 
                    height="120" 
                    horizAlign="center" 
                    vertAlign="center" />
            </Group>

            <!-- Tab Rechts: Favoriten (Inaktiv) -->
            <Group translation="[780, 0]">
                <Button
					id="FavoritesTabBtn"
                    text="Favoriten" 
                    font="font:MediumSystemFont" 
                    color="#A0A5AE" 
                    width="780" 
                    height="120" 
                    horizAlign="center" 
                    vertAlign="center" />
            </Group>
        </Group>

		<!-- Back button -->
		<Button
			id="BackBtn"
			text="Back to Welcome"
			font="font:SmallBoldSystemFont"
			size="[360,120]"
			color="#FFFFFF"
			focusRectColor="#3399FF"
			horizontalAlignment="center"
			translation="[1560,960]">
		</Button>
		<Node id="dialogPane" />
	</children>
</component>
