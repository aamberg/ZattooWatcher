<?xml version="1.0" encoding="UTF-8"?>

<component name="WelcomeScene" extends="Scene">
	<script type="text/brightscript" uri="pkg:/components/WelcomeScene.brs"/>

<children>
        <!-- Background / Base Layout -->
        <!-- Main background color matching greige theme -->
        <Rectangle 
            id="background" 
            width="1920" 
            height="1080" 
            color="#D0CDC4" />

        <!-- Left Sidebar Background -->
        <Rectangle 
            id="sidebarBg" 
            width="360" 
            height="1080" 
            color="#22252A" />

        <!-- Navigation Menu List -->
        <MarkupGrid
            id="sidebarMenu"
            itemSpacings="[20]"
            itemSize="[320, 80]"
            numColumns="1"
            itemComponentName="SidebarItemComponent"
            translation="[20, 300]"
            focusable="true" />

        <!-- Top Right Login Indicator Container -->
        <Group id="loginIndicatorGroup" translation="[1650, 40]">
            <!-- Green Dot -->
            <Rectangle
				id="LoginStatusCircle"
				width="24"
				height="24"
				color="0xFF0000FF"> <!-- Default red = not logged in -->
			</Rectangle>
            <!-- Status Text -->
			<Label
				id="LoginStatusLabel"
				text="Not logged in"
				font="font:MediumSystemFont"
				size="[16,24]"
				color="#2B2B2B" 
				horizontalAlignment="left"
				translation="[35,0]">
			</Label>
        </Group>

        <!-- Main Content Area (Clock & Date) -->
        <Group id="contentGroup" translation="[760, 380]">
            <!-- Large Time Display -->
            <MultiStyleLabel 
                id="timeLabel" 
                text="20:30" 
                font="font:LargeBoldSystemFont" 
                color="#FFFFFF" 
                width="800" 
                horizAlign="center" />

            <!-- Date Display -->
            <MultiStyleLabel 
                id="dateLabel" 
                text="FRIDAY, 17 MAY 2024" 
                font="font:MediumSystemFont" 
                color="#FFFFFF" 
                translation="[0, 160]" 
                width="800" 
                horizAlign="center" />
        </Group>

		<!-- Timer for clock updates -->
		<Timer
			id="ClockTimer"
			repeat="true"
			duration="1"> <!-- Update every second -->
		</Timer>

		<!-- TEMPORARY TEST TASK: Remove after testing token endpoint -->
		<TestTokenEndpoint
			id="TestTokenTask">
		</TestTokenEndpoint>

    </children>
</component>