<?xml version="1.0" encoding="UTF-8"?>

<component name="SettingsScene" extends="Scene">
	<script type="text/brightscript" uri="pkg:/components/SettingsScene.brs"/>

	<children>
		<!-- Background -->
		<Rectangle
			id="Background"
			width="1920"
			height="1080"
			color="0xD0CDC4FF">
		</Rectangle>

		<!-- Title -->
		<Label
			id="TitleLabel"
			text="Settings"
			font="font:LargeBoldSystemFont"
			size="[1920,60]"
			color="0x36322E"
			horizontalAlignment="center"
			verticalAlignment="center"
			translation="[805,40]">
		</Label>

		<!-- Tabs container -->
		<Group id="TabsContainer" translation="[192,120]" translationFocus="[192,120]">
			<Rectangle
				id="TabBarBackground"
				width="1536"
				height="48"
				color="0x36322ECC"> <!-- Semi-transparent dark -->
			</Rectangle>

			<!-- Tab 1: Login & Session -->
			<Button
				id="LoginTabBtn"
				text="User Settings"
				font="font:SmallBoldSystemFont"
				size="[500,48]"
				color="0xFFFFFF"
				focusRectColor="0x3399FF"
				horizontalAlignment="center">
			</Button>

			<!-- Tab 2: Favorites (visible only when logged in) -->
			<Button
				id="FavoritesTabBtn"
				text="Favorites"
				font="font:SmallBoldSystemFont"
				size="[500,48]"
				color="0xFFFFFF"
				focusRectColor="0x3399FF"
				horizontalAlignment="center"
				translation="[600,0]">
			</Button>
		</Group>

		<!-- Tab content area -->
		<Group id="TabContentContainer" translation="[192,180]" translationFocus="[192,180]">
			<!-- Login & Session tab content -->
			<Group id="LoginTabContent">
				<Label
					id="EmailLabel"
					text="Email:"
					font="font:SmallBoldSystemFont"
					size="[400,32]"
					color="0x36322E"
					horizontalAlignment="left"
					translation="[0,0]">
				</Label>

				<EditBox
					id="EmailInput"
					text=""
					font="font:SmallBoldSystemFont"
					size="[500,48]"
					color="0x36322E"
					horizontalAlignment="left"
					translation="[0,40]">
				</EditBox>

				<Label
					id="PasswordLabel"
					text="Password:"
					font="font:SmallBoldSystemFont"
					size="[400,32]"
					color="0x36322E"
					horizontalAlignment="left"
					translation="[0,120]">
				</Label>

				<EditBox
					id="PasswordInput"
					text=""
					font="font:SmallBoldSystemFont"
					size="[500,48]"
					color="0x36322E"
					horizontalAlignment="left"
					isSecure = "true"
					translation="[0,160]">
				</EditBox>

				<!-- Save / Login button -->
				<Button
					id="SaveLoginBtn"
					text="Login"
					font="font:SmallBoldSystemFont"
					size="[500,48]"
					color="0xFFFFFF"
					focusRectColor="0x3399FF"
					horizontalAlignment="center"
					translation="[0,240]">
				</Button>

				<!-- Status label (hidden by default) -->
				<Label
					id="StatusLabel"
					text=""
					font="font:SmallBoldSystemFont"
					size="[500,100]"
					color="0x36322E"
					horizontalAlignment="left"
					wrap = "true"
					visible = "false"
					translation="[0,320]">
				</Label>

				<!-- Logout button (visible only when logged in) -->
				<Button
					id="LogoutBtn"
					text="Logout"
					font="font:SmallBoldSystemFont"
					size="[500,48]"
					color="0xFFFFFF"
					focusRectColor="0xFF3333"
					horizontalAlignment="center"
					visible = "false"
					translation="[0,420]">
				</Button>
			</Group>

			<!-- Favorites tab content (placeholder for now) -->
			<Group id="FavoritesTabContent" visible="false">
				<Label
					id="FavoritesPlaceholderLabel"
					text="Favorites management coming soon."
					font="font:SmallBoldSystemFont"
					size="[500,48]"
					color="0x36322E"
					horizontalAlignment="left">
				</Label>
			</Group>
		</Group>

		<!-- Back button -->
		<Button
			id="BackBtn"
			text="Back to Welcome"
			font="font:SmallBoldSystemFont"
			size="[400,48]"
			color="0xFFFFFF"
			focusRectColor="0x3399FF"
			horizontalAlignment="center"
			translation="[1520,1000]">
		</Button>
	</children>
</component>
